{
	"name"				: "zsh-syntax",
	"displayName"	: "ZSH Syntax Highlighter",
	"description"	: "",
	"version"			: "0.0.1",

	"engines"			: { "vscode": "^1.144.0" },
	"categories"	: [ "Programming Languages" ],

	"contributes"	: {

		"languages": [{
			"id"							:		"zsh",
			"aliases"					:	[ "zsh", "z shell", "zshell" ],
			"configuration"		:		"./language-configuration.json",

			"extensions"			:	[ ".zsh" ],
			"filenames"				:	[ ".zshrc", ".zprofile", ".zshenv", ".zlogin", ".zlogout" ],
			"filenamePatterns":	[ "{.,}z{sh{rc,env},profile,log{in,out}}" ],
			"firstLine"				:		"^#!/(?:(?:usr/)?bin/|usr/bin/env )zsh"
		}],

		"grammars": [{
			"language"	: "zsh",
			"scopeName"	: "source.zsh",
			"path"			: "./syntaxes/zsh.tmLanguage.json"
		}]

	}
}
