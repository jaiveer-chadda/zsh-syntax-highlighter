{
	"name"				: "zsh-syntax",
	"displayName"	: "ZSH Syntax Highlighter",
	"description"	: "",
	"version"			: "0.0.1",

	"engines"			: { "vscode": "^1.137.0" },
	"categories"	: [ "Programming Languages" ],

	"contributes"	: {

		"languages": [{
			"id"							:		"zsh",
			"aliases"					:	[ "zsh", "z shell", "zshell" ],
			"configuration"		:		"./language-configuration.json",

			"extensions"			:	[ ".zsh" ],
			"filenames"				:	[ ".zshrc", ".zprofile", ".zshenv", ".zlogin", ".zlogout" ]
		}],

		"grammars": [{
			"language"	: "zsh",
			"scopeName"	: "source.zsh",
			"path"			: "./syntaxes/zsh.tmLanguage.json"
		}]

	}
}
