					"endCaptures"		: { "0": { "name": "keyword.control.zsh" } },

					"patterns": [{ "include": "#initial_context" }]
				},


				{
					"name": "meta.scope.select-block.zsh",

					"begin"	: "(?<=^|;|&|\\s)(select)\\s+((?:[^\\s\\\\]|\\\\.)+)(?=\\s|;|&|$)",
					"end"		: "(?<=^|;|&|\\s)(done)(?=\\s|;|&|$|\\))",

