		"herestring": {
			"comment": "",
			"patterns": [
				{
					"name": "meta.herestring.zsh",
					"contentName": "string.quoted.single.zsh",

					"begin"	: "(<<<)\\s*(('))",
					"end"		: "(')",

					"beginCaptures": {
						"1": { "name": "keyword.operator.herestring.zsh" },
						"2": { "name": "string.quoted.single.zsh" },
						"3": { "name": "punctuation.definition.string.begin.zsh" }
					},
					"endCaptures": {
						"0": { "name": "string.quoted.single.zsh" },
						"1": { "name": "punctuation.definition.string.end.zsh" }
					}
				},


				{
					"name": "meta.herestring.zsh",
					"contentName": "string.quoted.double.zsh",

					"begin"	: "(<<<)\\s*((\"))",
					"end"		: "(\")",

					"beginCaptures": {
						"1": { "name": "keyword.operator.herestring.zsh" },
						"2": { "name": "string.quoted.double.zsh" },
						"3": { "name": "punctuation.definition.string.begin.zsh" }
					},
					"endCaptures": {
						"0": { "name": "string.quoted.double.zsh" },
						"1": { "name": "punctuation.definition.string.end.zsh" }
					},


					"patterns": [{ "include": "#double_quote_context" }]
				},


				{
					"name": "meta.herestring.zsh",
					"match": "(<<<)\\s*(([^\\s)\\\\]|\\\\.)+)",

					"captures": {
						"1": { "name": "keyword.operator.herestring.zsh" },
						"2": {
							"name": "string.unquoted.herestring.zsh",
							"patterns": [{ "include": "#initial_context" }]
						}
					}
				}

			]
		},


		"inline_comment": {
			"comment": "",
			"match": "(\\/\\*)((?:(?:[^\\*]|(?:(?:\\*++)[^\\/]))*+)((?:(?:\\*++)\\/)))",
			"captures": {
				"1": { "name": "comment.block.zsh punctuation.definition.comment.begin.zsh" },
				"2": { "name": "comment.block.zsh" },
				"3": {
					"patterns": [
						{ "match": "\\*\\/", "name": "comment.block.zsh punctuation.definition.comment.end.zsh" },
						{ "match": "\\*", "name": "comment.block.zsh" }
					]
				}
			}
		},


		"interpolation": {
			"comment": "",
			"patterns": [
				{ "include": "#arithmetic_dollar" },
				{ "include": "#subshell_dollar" },

				{
					"name": "string.interpolated.backtick.zsh",

					"begin"	: "`",
					"end"		: "`",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.evaluation.backticks.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.definition.evaluation.backticks.zsh" } },

					"patterns": [
						{ "match": "\\\\[`\\\\$]", "name": "constant.character.escape.zsh" },
						{
							"begin"	: "(?<=\\W)(?=#)(?!#{)",
							"end"		: "(?!\\G)",

							"beginCaptures": { "1": { "name": "punctuation.whitespace.comment.leading.zsh" } },

							"patterns": [
								{
									"name": "comment.line.number-sign.zsh",

									"begin"	: "#",
									"end"		: "(?=`)",

									"beginCaptures": { "0": { "name": "punctuation.definition.comment.zsh" } }
								}
							]
						},
						{ "include": "#initial_context" }
					]

				}

			]
		},


		"keyword": {
			"comment": "",
			"patterns": [
				{
					"match": "(?<=^|;|&|\\s)(then|else|elif|fi|for|in|do|done|select|continue|esac|while|until|return)(?=\\s|;|&|$)",
					"name": "keyword.control.zsh"
				},
				{
					"match": "(?<=^|;|&|\\s)(?:export|declare|typeset|local|readonly)(?=\\s|;|&|$)",
					"name": "storage.modifier.zsh"
				}
			]
		},


		"line_comment": {
			"name": "comment.line.double-slash.zsh",
			"comment": "",

			"begin"	: "(?:\\s*+)(\\/\\/)",
			"end"		: "(?<=\\n)(?<!\\\\\\n)",

			"beginCaptures"	: { "1": { "name": "punctuation.definition.comment.zsh" } },
			"endCaptures"		: {},

			"patterns": [{ "include": "#line_continuation_character" }]
		},


		"line_continuation": {
			"name": "constant.character.escape.line-continuation.zsh",
			"comment": "",
			"match": "\\\\(?=\\n)"
		},


		"logical-expression": {
			"comment": "",
			"patterns": [
				{ "include": "#arithmetic_no_dollar" },
				{
					"name": "keyword.operator.logical.zsh",
					"comment": "do we want a special rule for ( expr )?",
					"match": "=[=~]?|!=?|<|>|&&|\\|\\|"
				},
				{
					"name": "keyword.operator.logical.zsh",
					"match": "(?<!\\S)-(nt|ot|ef|eq|ne|l[te]|g[te]|[a-hknoprstuwxzOGLSN])\\b"
				}
			]
		},


		"logical_expression_double": {
			"name": "meta.scope.logical-expression.zsh",
			"comment": "",

			"begin"	: "\\[\\[",
			"end"		: "\\]\\]",
			"beginCaptures"	: { "0": { "name": "punctuation.definition.logical-expression.zsh" } },
			"endCaptures"		: { "0": { "name": "punctuation.definition.logical-expression.zsh" } },
			"patterns": [{ "include": "#logical_expression_context" }]
		},


		"logical_expression_single": {
			"name": "meta.scope.logical-expression.zsh",
			"comment": "",

			"begin"	: "\\[",
			"end"		: "\\]",

			"beginCaptures"	: { "0": { "name": "punctuation.definition.logical-expression.zsh" } },
			"endCaptures"		: { "0": { "name": "punctuation.definition.logical-expression.zsh" } },

			"patterns": [{ "include": "#logical_expression_context" }]
		},


		"loop": {
			"comment": "",
			"patterns": [
				{
					"name": "meta.scope.for-in-loop.zsh",

					"begin"	: "(?<=^|;|&|\\s)(for)\\s+(.+?)\\s+(in)(?=\\s|;|&|$)",
					"end"		: "(?<=^|;|&|\\s)done(?=\\s|;|&|$|\\))",

					"beginCaptures": {
