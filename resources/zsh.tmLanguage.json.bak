					"patterns": [
						{ "include": "#logical-expression" },
						{ "include": "#initial_context" }
					]
				},


				{
					"name": "meta.scope.group.zsh",

					"begin"	: "(?<=\\s|^){(?=\\s|$)",
					"end"		: "(?<=^|;)\\s*(})",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.group.zsh" } },
					"endCaptures"		: { "1": { "name": "punctuation.definition.group.zsh" } },

					"patterns": [{ "include": "#initial_context" }]
				}
			]
		},


		"continuation_of_double_quoted_command_name": {
			"comment": "",
			"contentName": "meta.statement.command.name.continuation string.quoted.double entity.name.function.call entity.name.command",

			"begin"	: "(?:\\G(?<=\"))",
			"end"		: "\"",

			"beginCaptures": {},
			"endCaptures": { "0": { "name": "string.quoted.double.zsh punctuation.definition.string.end.zsh entity.name.function.call.zsh entity.name.command.zsh" } },

			"patterns": [
				{ "name": "constant.character.escape.zsh", "match": "\\\\[\\$\\n`\"\\\\]" },
				{ "include": "#variable" },
				{ "include": "#interpolation" }
			]
		},


		"continuation_of_single_quoted_command_name": {
			"comment": "",
			"contentName": "meta.statement.command.name.continuation string.quoted.single entity.name.function.call entity.name.command",

			"begin"	: "(?:\\G(?<='))",
			"end"		: "'",

			"beginCaptures"	: {},
			"endCaptures"		: { "0": { "name": "string.quoted.single.zsh punctuation.definition.string.end.zsh entity.name.function.call.zsh entity.name.command.zsh" } }
		},


		"double_quote_context": {
			"comment": "",
			"patterns": [
				{ "name": "constant.character.escape.zsh", "match": "\\\\[\\$`\"\\\\\\n]" },
				{ "include": "#variable" },
				{ "include": "#interpolation" }
			]
		},


		"double_quote_escape_char": {
			"name": "constant.character.escape.zsh",
			"comment": "",
			"match": "\\\\[\\$`\"\\\\\\n]"
		},


		"floating_keyword": {
			"comment": "",
			"patterns": [{ "name": "keyword.control.$0.zsh", "match": "(?<=^|;|&| |\\t)(?:then|elif|else|done|end|do|if|fi)(?= |\\t|;|&|$)" }]
		},


		"for_statement": {
			"comment": "",
			"patterns": [
				{
					"name": "meta.for.in.zsh",

					"begin"	: "(?:(\\bfor\\b)(?:(?:[ \\t]*+)((?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))(?:[ \\t]*+)(\\bin\\b)))",
					"end"		: "(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)",

					"beginCaptures": {
						"1": { "name": "keyword.control.for.zsh" },
						"2": { "name": "variable.other.for.zsh" },
						"3": { "name": "keyword.control.in.zsh" }
					},
					"endCaptures": {},

					"patterns": [
						{ "include": "#string" },
						{ "include": "#simple_unquoted" },
						{ "include": "#normal_context" }
					]
				},


				{
					"name": "meta.for.zsh",

					"begin"	: "(\\bfor\\b)",
					"end"		: "(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)",

					"beginCaptures"	: { "1": { "name": "keyword.control.for.zsh" } },
					"endCaptures"		: {},

					"patterns": [
						{ "include": "#arithmetic_double" },
						{ "include": "#normal_context" }
					]
				}

			]
		},


		"function_definition": {
			"name": "meta.function.zsh",
			"comment": "",

			"begin"	: "(?:[ \\t]*+)(?:(?:(\\bfunction\\b)(?:[ \\t]*+)([^ \\t\\n\\r\\(\\)=\"']+)(?:(?:(\\()(?:[ \\t]*+)(\\)))?))|(?:([^ \\t\\n\\r\\(\\)=\"']+)(?:[ \\t]*+)(\\()(?:[ \\t]*+)(\\))))",
			"end"		: "(?<=\\}|\\))",

			"beginCaptures": {
				"1": { "name": "storage.type.function.zsh" },
				"2": { "name": "entity.name.function.zsh" },
				"3": { "name": "punctuation.definition.arguments.zsh" },
				"4": { "name": "punctuation.definition.arguments.zsh" },
				"5": { "name": "entity.name.function.zsh" },
				"6": { "name": "punctuation.definition.arguments.zsh" },
				"7": { "name": "punctuation.definition.arguments.zsh" }
			},
			"endCaptures": {},

			"patterns": [
				{ "match": "(?:\\G(?:\\t| |\\n))" },
				{
					"name": "meta.function.body.zsh",

