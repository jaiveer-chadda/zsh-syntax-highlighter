					"patterns": [{ "include": "#initial_context" }]
				},


				{
					"name": "meta.function.body.zsh",

					"begin"	: "\\(",
					"end"		: "\\)",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.group.zsh punctuation.section.function.definition.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.definition.group.zsh punctuation.section.function.definition.zsh" } },

					"patterns": [{ "include": "#initial_context" }]
				},


				{ "include": "#initial_context" }
			],

			"applyEndPatternLast": 1
		},


		"heredoc": {
			"comment": "",
			"patterns": [
				{
					"contentName": "string.quoted.heredoc.indent.$3",

					"begin": "(?:((?<!<)(?:<<-))(?:[ \\t]*+)(\"|')(?:[ \\t]*+)([^\"']+?)(?=\\s|;|&|<|\"|')((?:\\2))(.*))",
					"end": "(?:(?:^\\t*)(?:\\3)(?=\\s|;|&|$))",

					"beginCaptures": {
						"1": { "name": "keyword.operator.heredoc.zsh" },
						"2": { "name": "punctuation.definition.string.heredoc.quote.zsh" },
						"3": { "name": "punctuation.definition.string.heredoc.delimiter.zsh" },
						"4": { "name": "punctuation.definition.string.heredoc.quote.zsh" },
						"5": {
