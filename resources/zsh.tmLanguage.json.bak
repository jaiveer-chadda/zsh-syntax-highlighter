{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "zsh",
	"scopeName": "source.zsh",

	"fileTypes": [ ".zsh" ],
	"firstLineMatch": "#!/usr/bin/env zsh",

	"patterns": [{ "include": "#initial_context" }],

	"repository": {




		"initial_context": {
			"comment": "",
			"patterns": [
				{ "include": "#comment"											},
				{ "include": "#pipeline"										},
				{ "include": "#normal_statement_seperator"	},
				{ "include": "#logical_expression_double"		},
				{ "include": "#logical_expression_single"		},
				{ "include": "#assignment_statement"				},
				{ "include": "#case_statement"							},
				{ "include": "#for_statement"								},
				{ "include": "#loop"												},
				{ "include": "#function_definition"					},
				{ "include": "#line_continuation"						},
				{ "include": "#arithmetic_double"						},
				{ "include": "#misc_ranges"									},
				{ "include": "#variable"										},
				{ "include": "#interpolation"								},
				{ "include": "#heredoc"											},
				{ "include": "#herestring"									},
				{ "include": "#redirection"									},
				{ "include": "#pathname"										},
				{ "include": "#floating_keyword"						},
				{ "include": "#alias_statement"							},
				{ "include": "#normal_statement"						},
				{ "include": "#string"											},
				{ "include": "#support"											}
			]
		},


		"normal_context": {
			"comment": "",
			"patterns": [
				{ "include": "#comment"											},
				{ "include": "#pipeline"										},
				{ "include": "#normal_statement_seperator"	},
				{ "include": "#misc_ranges"									},
				{ "include": "#boolean"											},
				{ "include": "#redirect_number"							},
				{ "include": "#numeric_literal"							},
				{ "include": "#string"											},
				{ "include": "#variable"										},
				{ "include": "#interpolation"								},
				{ "include": "#heredoc"											},
				{ "include": "#herestring"									},
				{ "include": "#redirection"									},
				{ "include": "#pathname"										},
				{ "include": "#floating_keyword"						},
				{ "include": "#support"											},
				{ "include": "#parenthese"									}
			]
		},

		"assignment_statement": {
			"comment": "",
			"patterns": [
				{ "include": "#array_value"										},
				{ "include": "#modified_assignment_statement"	},
				{ "include": "#normal_assignment_statement"		}
			]
		},


		"comments": {
			"comment": "",
			"patterns": [
				{ "include": "#block_comment"	},
				{ "include": "#line_comment"	}
			]
		},


		"logical_expression_context": {
			"comment": "",
			"patterns": [
				{ "include": "#regex_comparison"						},
				{ "include": "#arithmetic_no_dollar"				},
				{ "include": "#logical-expression"					},
				{ "include": "#logical_expression_single"		},
				{ "include": "#logical_expression_double"		},
				{ "include": "#comment"											},
				{ "include": "#boolean"											},
				{ "include": "#redirect_number"							},
				{ "include": "#numeric_literal"							},
				{ "include": "#pipeline"										},
				{ "include": "#normal_statement_seperator"	},
				{ "include": "#string"											},
				{ "include": "#variable"										},
				{ "include": "#interpolation"								},
				{ "include": "#heredoc"											},
				{ "include": "#herestring"									},
				{ "include": "#pathname"										},
				{ "include": "#floating_keyword"						},
				{ "include": "#support"											}
			]
		},


		"option_context": {
			"comment": "",
			"patterns": [
				{ "include": "#misc_ranges"				},
				{ "include": "#string"						},
				{ "include": "#variable"					},
				{ "include": "#interpolation"			},
				{ "include": "#heredoc"						},
				{ "include": "#herestring"				},
				{ "include": "#redirection"				},
				{ "include": "#pathname"					},
				{ "include": "#floating_keyword"	},
				{ "include": "#support"						}
			]
		},


		"typical_statements": {
			"comment": "",
			"patterns": [
				{ "include": "#assignment_statement"	},
				{ "include": "#case_statement"				},
				{ "include": "#for_statement"					},
				{ "include": "#while_statement"				},
				{ "include": "#function_definition"		},
				{ "include": "#command_statement"			},
				{ "include": "#line_continuation"			},
				{ "include": "#arithmetic_double"			},
				{ "include": "#normal_context"				}
			]
		},






		"alias_statement": {
			"name": "meta.expression.assignment.alias.zsh",
			"comment": "",

			"begin"	: "(?:(?:[ \\t]*+)(alias)(?:[ \\t]*+)((?:(?:((?<!\\w)-\\w+\\b)(?:[ \\t]*+))*))(?:(?:[ \\t]*+)(?:((?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))(?:(?:(\\[)((?:(?:(?:(?:\\$?)(?:(?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))|@)|\\*)|(-?\\d+)))(\\]))?))(?:(?:(\\=)|(\\+\\=))|(\\-\\=))))",
			"end"		: "(?:(?= |\\t|$)|(?:(?:(?:(;)|(&&))|(\\|\\|))|(&)))",

			"beginCaptures": {
				"1"	: { "name": "storage.type.alias.zsh"																																								},
				"2"	: { "patterns": [{ "name": "string.unquoted.argument.zsh constant.other.option.zsh", "match": "(?<!\\w)-\\w+\\b" }]	},
				"3"	: { "name": "string.unquoted.argument.zsh constant.other.option.zsh"																								},
				"4"	: { "name": "variable.other.assignment.zsh"																																					},
				"5"	: { "name": "punctuation.definition.array.access.zsh"																																},
				"6"	: { "name": "variable.other.assignment.zsh"																																					},
				"7"	: { "name": "constant.numeric.zsh constant.numeric.integer.zsh"																											},
				"8"	: { "name": "punctuation.definition.array.access.zsh"																																},
				"9"	: { "name": "keyword.operator.assignment.zsh"																																				},
				"10": { "name": "keyword.operator.assignment.compound.zsh"																															},
				"11": { "name": "keyword.operator.assignment.compound.zsh"																															}
			},
			"endCaptures": {
				"1": { "name": "punctuation.terminator.statement.semicolon.zsh"	},
				"2": { "name": "punctuation.separator.statement.and.zsh"				},
				"3": { "name": "punctuation.separator.statement.or.zsh"					},
				"4": { "name": "punctuation.separator.statement.background.zsh"	}
			},

			"patterns": [{ "include": "#normal_context" }]
		},


		"argument": {
			"name": "meta.argument.zsh",
			"comment": "",

			"begin"	: "(?:[ \\t]++)(?!(?:&|\\||\\(|\\[|#|\\n|$|;))",
			"end"		: "(?= |\\t|;|\\||&|$|\\n|\\)|\\`)",

			"beginCaptures": {},
			"endCaptures": {},

			"patterns": [
				{ "include": "#argument_context"	},
				{ "include": "#line_continuation"	}
			]
		},


		"argument_context": {
			"comment": "",

			"patterns": [
				{ "include": "#normal_context" },

				{ "match": "(?:[ \\t]*+)((?:[^ \t\n>&;<>\\(\\)\\$`\\\\\"'<\\|]+)(?!>))",

					"captures": { "1": {
						"name": "string.unquoted.argument.zsh",
						"patterns": [
							{ "name": "variable.language.special.wildcard.zsh", "match": "\\*" },
							{ "include": "#variable"				},
							{ "include": "#numeric_literal"	},
							{
								"match": "(?<!\\w)(\\b(?:true|false)\\b)(?!\\w)",
								"captures": { "1": { "name": "constant.language.$1.zsh" } }
							}
						]}
					}
				}

			]
		},


		"arithmetic_double": {
			"comment": "",
			"patterns": [
				{
					"name": "meta.arithmetic.zsh",

					"begin"	: "\\(\\(",
					"end"		: "\\)(?:\\s*)\\)",

					"beginCaptures"	: { "0": { "name": "punctuation.section.arithmetic.double.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.section.arithmetic.double.zsh" } },

					"patterns": [{ "include": "#math" }, { "include": "#string" }]
				}
			]
		},


		"arithmetic_no_dollar": {
			"comment": "",
			"patterns": [
				{
					"name": "meta.arithmetic.zsh",

					"begin"	: "\\(",
					"end"		: "\\)",

					"beginCaptures"	: { "0": { "name": "punctuation.section.arithmetic.single.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.section.arithmetic.single.zsh" } },

					"patterns": [{ "include": "#math" }, { "include": "#string" }]
				}
			]
		},


		"array_access_inline": {
			"comment": "",
			"match": "(?:(\\[)([^\\[\\]]+)(\\]))",

			"captures": {
				"1": { "name": "punctuation.section.array.zsh" },
				"2": {
					"patterns": [
						{ "include": "#special_expansion" },
						{ "include": "#string" },
						{ "include": "#variable" }
					]
				},
				"3": { "name": "punctuation.section.array.zsh" }
			}
		},


		"array_value": {
			"comment": "",
			"begin"	: "(?:[ \\t]*+)(?:((?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))(?:(?:(\\[)((?:(?:(?:(?:\\$?)(?:(?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))|@)|\\*)|(-?\\d+)))(\\]))?))(?:(?:(\\=)|(\\+\\=))|(\\-\\=))(?:[ \\t]*+)(\\()",
			"end"		: "\\)",

			"beginCaptures": {
				"1": { "name": "variable.other.assignment.zsh" },
				"2": { "name": "punctuation.definition.array.access.zsh" },
				"3": { "name": "variable.other.assignment.zsh" },
				"4": { "name": "constant.numeric.zsh constant.numeric.integer.zsh" },
				"5": { "name": "punctuation.definition.array.access.zsh" },
				"6": { "name": "keyword.operator.assignment.zsh" },
				"7": { "name": "keyword.operator.assignment.compound.zsh" },
				"8": { "name": "keyword.operator.assignment.compound.zsh" },
				"9": { "name": "punctuation.definition.array.zsh" }
			},
			"endCaptures": { "0": { "name": "punctuation.definition.array.zsh" } },

			"patterns": [
				{ "include": "#comment" },

				{
					"match": "(?:((?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))(\\=))",
					"captures": {
						"1": { "name": "variable.other.assignment.array.zsh entity.other.attribute-name.zsh" },
						"2": { "name": "keyword.operator.assignment.zsh punctuation.definition.assignment.zsh" }
					}
				},


				{
					"match": "(?:(\\[)(.+?)(\\])(\\=))",
					"captures": {
						"1": { "name": "punctuation.definition.bracket.named-array.zsh" },
						"2": { "name": "string.unquoted.zsh entity.other.attribute-name.bracket.zsh" },
						"3": { "name": "punctuation.definition.bracket.named-array.zsh" },
						"4": { "name": "punctuation.definition.assignment.zsh" }
					}
				},


				{ "include": "#normal_context" },
				{ "include": "#simple_unquoted" }
			]
		},


		"basic_command_name": {
			"name": "meta.statement.command.name.basic.zsh",
			"comment": "",

			"match": "(?:(?:(?!(?:!|&|\\||\\(|\\)|\\{|\\[|<|>|#|\\n|$|;|[ \\t]))(?!nocorrect |nocorrect\t|nocorrect$|readonly |readonly\t|readonly$|function |function\t|function$|foreach |foreach\t|foreach$|coproc |coproc\t|coproc$|logout |logout\t|logout$|export |export\t|export$|select |select\t|select$|repeat |repeat\t|repeat$|pushd |pushd\t|pushd$|until |until\t|until$|while |while\t|while$|local |local\t|local$|case |case\t|case$|done |done\t|done$|elif |elif\t|elif$|else |else\t|else$|esac |esac\t|esac$|popd |popd\t|popd$|then |then\t|then$|time |time\t|time$|for |for\t|for$|end |end\t|end$|fi |fi\t|fi$|do |do\t|do$|in |in\t|in$|if |if\t|if$))(?:((?<=^|;|&|[ \\t])(?:readonly|declare|typeset|export|local)(?=[ \\t]|;|&|$))|((?!\"|'|\\\\\\n?$)(?:[^!'\"<> \\t\\n\\r]+?)))(?:(?= |\\t)|(?:(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\))))",

			"captures": {
				"1": { "name": "storage.modifier.$1.zsh" },
				"2": {
					"name": "entity.name.function.call.zsh entity.name.command.zsh",
					"patterns": [
						{ "name": "keyword.control.$0.zsh"			, "match": "(?<!\\w)(?:continue|return|break)(?!\\w)" },
						{ "name": "support.function.builtin.zsh", "match": "(?<!\\w)(?:(?:unfunction|continue|autoload|unsetopt|bindkey|builtin|getopts|command|declare|unalias|history|unlimit|typeset|suspend|source|printf|unhash|disown|ulimit|return|which|alias|break|false|print|shift|times|umask|umask|unset|read|type|exec|eval|wait|echo|dirs|jobs|kill|hash|stat|exit|test|trap|true|let|set|pwd|cd|fg|bg|fc|:|\\.)(?!\\/))(?!\\w)(?!-)" },
						{ "include": "#variable" }
					]
				}
			}
		},


		"block_comment": {
			"name": "comment.block.zsh",
			"comment": "",

			"begin"	: "(?:(?:\\s*+)(\\/\\*))",
			"end"		: "\\*\\/",

			"beginCaptures"	: { "1": { "name": "punctuation.definition.comment.begin.zsh" } },
			"endCaptures"		: { "0": { "name": "punctuation.definition.comment.end.zsh" } }
		},


		"boolean": {
			"name": "constant.language.$0.zsh",
			"comment": "",
			"match": "\\b(?:true|false)\\b"
		},


		"case_statement": {
			"name": "meta.case.zsh",
			"comment": "",

			"begin"	: "(?:(\\bcase\\b)(?:[ \\t]*+)(.+?)(?:[ \\t]*+)(\\bin\\b))",
			"end"		: "\\besac\\b",

			"beginCaptures": {
				"1": { "name": "keyword.control.case.zsh" },
				"2": { "patterns": [{ "include": "#initial_context" }] },
				"3": { "name": "keyword.control.in.zsh" }
			},
			"endCaptures": { "0": { "name": "keyword.control.esac.zsh" } },

			"patterns": [
				{ "include": "#comment" },

				{
					"match": "(?:[ \\t]*+)(\\* *\\))",
					"captures": { "1": { "name": "keyword.operator.pattern.case.default.zsh" } }
				},


				{
					"name": "meta.case.entry.pattern.zsh",
					"patterns": [{ "include": "#case_statement_context" }],

					"begin"	: "(?<!\\))(?!(?:[ \\t]*+)(?:esac\\b|$))",
					"end"		: "(?:(?=\\besac\\b)|(\\)))",

					"beginCaptures"	: {},
					"endCaptures"		: { "1": { "name": "keyword.operator.pattern.case.zsh" } }
				},


				{
					"name": "meta.case.entry.body.zsh",

					"begin"	: "(?<=\\))",
					"end"		: "(?:(;;)|(?=\\besac\\b))",

					"beginCaptures"	: {},
					"endCaptures"		: { "1": { "name": "punctuation.terminator.statement.case.zsh" } },

					"patterns": [
						{ "include": "#typical_statements" },
						{ "include": "#initial_context" }
					]
				}

			]
		},


		"case_statement_context": {
			"comment": "",

			"patterns": [
				{ "match": "\\*"		, "name": "variable.language.special.quantifier.star.zsh keyword.operator.quantifier.star.zsh punctuation.definition.arbitrary-repetition.zsh punctuation.definition.regex.arbitrary-repetition.zsh" },
				{ "match": "\\+"		, "name": "variable.language.special.quantifier.plus.zsh keyword.operator.quantifier.plus.zsh punctuation.definition.arbitrary-repetition.zsh punctuation.definition.regex.arbitrary-repetition.zsh" },
				{ "match": "\\?"		, "name": "variable.language.special.quantifier.question.zsh keyword.operator.quantifier.question.zsh punctuation.definition.arbitrary-repetition.zsh punctuation.definition.regex.arbitrary-repetition.zsh" },
				{ "match": "@"			, "name": "variable.language.special.at.zsh keyword.operator.at.zsh punctuation.definition.regex.at.zsh" },
				{ "match": "\\|"		, "name": "keyword.operator.orvariable.language.special.or.zsh keyword.operator.alternation.ruby.zsh punctuation.definition.regex.alternation.zsh punctuation.separator.regex.alternation.zsh" },
				{ "match": "\\\\."	, "name": "constant.character.escape.zsh" },

				{ "match": "(?<=\\tin| in| |\\t|;;)\\(", "name": "keyword.operator.pattern.case.zsh" },

				{
					"name": "meta.parenthese.zsh",

					"begin"	: "(?<=\\S)(\\()",
					"end"		: "\\)",

					"beginCaptures"	: { "1": { "name": "punctuation.definition.group.zsh punctuation.definition.regex.group.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.definition.group.zsh punctuation.definition.regex.group.zsh" } },

					"patterns": [{ "include": "#case_statement_context" }]
				},


				{
					"name": "string.regexp.character-class.zsh",

					"begin"	: "\\[",
					"end"		: "\\]",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.character-class.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.definition.character-class.zsh" } },

					"patterns": [{ "match": "\\\\.", "name": "constant.character.escape.zsh" }]
				},


				{ "include": "#string" },

				{ "name": "string.unquoted.pattern.zsh string.regexp.unquoted.zsh", "match": "[^) \\t\\n\\[\\?\\*\\|\\@]" }
			]
		},


		"command_name_range": {
			"name": "meta.statement.command.name.zsh",
			"comment": "",

			"begin"	: "\\G",
			"end"		: "(?:(?= |\\t|;|\\||&|$|\\n|\\)|\\`)|(?=<))",

			"beginCaptures"	: {},
			"endCaptures"		: {},

			"patterns": [
				{
					"name": "entity.name.function.call.zsh entity.name.command.zsh keyword.control.$0.zsh",
					"match": "(?<!\\w)(?:continue|return|break)(?!\\w)"
				},


				{
					"match": "(?<!\\w)(?:(?:unfunction|continue|autoload|unsetopt|bindkey|builtin|getopts|command|declare|unalias|history|unlimit|typeset|suspend|source|printf|unhash|disown|ulimit|return|which|alias|break|false|print|shift|times|umask|umask|unset|read|type|exec|eval|wait|echo|dirs|jobs|kill|hash|stat|exit|test|trap|true|let|set|pwd|cd|fg|bg|fc|:|\\.)(?!\\/))(?!\\w)(?!-)",
					"name": "entity.name.function.call.zsh entity.name.command.zsh support.function.builtin.zsh"
				},


				{ "include": "#variable" },

				{
					"match": "(?:(?<!\\w)(?<=\\G|'|\"|\\}|\\))([^ \\n\\t\\r\"'=;&\\|`\\)\\{<>]+))",
					"captures": { "1": { "name": "entity.name.function.call.zsh entity.name.command.zsh" } }
				},


				{
					"begin"	: "(?:(?:\\G|(?<! |\\t|;|\\||&|\\n|\\{|#))(?:(\\$?)((?:(\")|(')))))",
					"end"		: "(?<!\\G)(?<=(?:\\2))",

					"beginCaptures": {
						"1": { "name": "meta.statement.command.name.quoted.zsh punctuation.definition.string.zsh entity.name.function.call.zsh entity.name.command.zsh" },
						"2": {},
						"3": { "name": "meta.statement.command.name.quoted.zsh string.quoted.double.zsh punctuation.definition.string.begin.zsh entity.name.function.call.zsh entity.name.command.zsh" },
						"4": { "name": "meta.statement.command.name.quoted.zsh string.quoted.single.zsh punctuation.definition.string.begin.zsh entity.name.function.call.zsh entity.name.command.zsh" }
					},
					"endCaptures": {},

					"patterns": [
						{ "include": "#continuation_of_single_quoted_command_name" },
						{ "include": "#continuation_of_double_quoted_command_name" }
					]
				},


				{ "include": "#line_continuation" },
				{ "include": "#simple_unquoted" }
			]
		},


		"command_statement": {
			"name": "meta.statement.command.zsh",
			"comment": "",

			"begin"	: "(?:(?:[ \\t]*+)(?:(?!(?:!|&|\\||\\(|\\)|\\{|\\[|<|>|#|\\n|$|;|[ \\t]))(?!nocorrect |nocorrect\t|nocorrect$|readonly |readonly\t|readonly$|function |function\t|function$|foreach |foreach\t|foreach$|coproc |coproc\t|coproc$|logout |logout\t|logout$|export |export\t|export$|select |select\t|select$|repeat |repeat\t|repeat$|pushd |pushd\t|pushd$|until |until\t|until$|while |while\t|while$|local |local\t|local$|case |case\t|case$|done |done\t|done$|elif |elif\t|elif$|else |else\t|else$|esac |esac\t|esac$|popd |popd\t|popd$|then |then\t|then$|time |time\t|time$|for |for\t|for$|end |end\t|end$|fi |fi\t|fi$|do |do\t|do$|in |in\t|in$|if |if\t|if$)(?!\\\\\\n?$)))",
			"end"		: "(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)",

			"beginCaptures"	: {},
			"endCaptures"		: {},

			"patterns": [
				{ "include": "#command_name_range" },
				{ "include": "#line_continuation" },
				{ "include": "#option" },
				{ "include": "#argument" },
				{ "include": "#string" },
				{ "include": "#heredoc" }
			]
		},


		"comment": {
			"comment": "",
			"match": "(?:(?:^|(?:[ \\t]++))(?:((?:(#!)(?:.*)))|((?:(#)(?:.*)))))",
