						{ "include": "#variable" },
						{ "include": "#interpolation" }
					]
				},


				{
					"contentName": "string.unquoted.heredoc.no-indent.$2",

					"begin"	: "(?:((?<!<)(?:<<)(?!<))(?:[ \\t]*+)([^\"' \\t]+)(?=\\s|;|&|<|\"|')(.*))",
					"end"		: "(?:^(?:\\2)(?=\\s|;|&|$))",

					"beginCaptures": {
						"1": { "name": "keyword.operator.heredoc.zsh" },
						"2": { "name": "punctuation.definition.string.heredoc.delimiter.zsh" },
						"3": {
