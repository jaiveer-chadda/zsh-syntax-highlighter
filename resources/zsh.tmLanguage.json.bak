								{ "include": "#redirect_fix" },
								{ "include": "#typical_statements" }
							]
						}
					},
					"endCaptures": { "0": { "name": "punctuation.definition.string.heredoc.delimiter.zsh" } },

					"patterns": []
				},


				{
					"contentName": "string.unquoted.heredoc.indent.$2",

					"begin"	: "(?:((?<!<)(?:<<-))(?:[ \\t]*+)([^\"' \\t]+)(?=\\s|;|&|<|\"|')(.*))",
					"end"		: "(?:(?:^\\t*)(?:\\2)(?=\\s|;|&|$))",

					"beginCaptures": {
						"1": { "name": "keyword.operator.heredoc.zsh" },
						"2": { "name": "punctuation.definition.string.heredoc.delimiter.zsh" },
						"3": {
