					"beginCaptures"	: { "0": { "name": "keyword.control.if.zsh" } },
					"endCaptures"		: { "0": { "name": "keyword.control.fi.zsh" } },

					"patterns": [{ "include": "#initial_context" }]
				}
			]
		},


		"math": {
			"comment": "",
			"patterns": [
				{ "include": "#variable" },
				{ "name": "keyword.operator.arithmetic.zsh"			, "match": "\\+{1,2}|-{1,2}|!|~|\\*{1,2}|/|%|<[<=]?|>[>=]?|==|!=|^|\\|{1,2}|&{1,2}|\\?|\\:|,|=|[*/%+\\-&^|]=|<<=|>>=" },
				{ "name": "constant.numeric.hex.zsh"						, "match": "0[xX][0-9A-Fa-f]+" },
				{ "name": "punctuation.separator.semicolon.range"	, "match": ";" },
				{ "name": "constant.numeric.octal.zsh"					, "match": "0\\d+" },
				{ "name": "constant.numeric.other.zsh"					, "match": "\\d{1,2}#[0-9a-zA-Z@_]+" },
				{ "name": "constant.numeric.integer.zsh"				, "match": "\\d+" },
				{ "name": "variable.other.normal.zsh"						, "match": "(?<!\\w)(?:[a-zA-Z_0-9]+)(?!\\w)" }
			]
		},


		"math_operators": {
			"comment": "",
			"patterns": [
				{ "name": "keyword.operator.arithmetic.zsh"	, "match": "\\+{1,2}|-{1,2}|!|~|\\*{1,2}|/|%|<[<=]?|>[>=]?|==|!=|^|\\|{1,2}|&{1,2}|\\?|\\:|,|=|[*/%+\\-&^|]=|<<=|>>=" },
				{ "name": "constant.numeric.hex.zsh"				, "match": "0[xX][0-9A-Fa-f]+" },
				{ "name": "constant.numeric.octal.zsh"			, "match": "0\\d+" },
				{ "name": "constant.numeric.other.zsh"			, "match": "\\d{1,2}#[0-9a-zA-Z@_]+" },
				{ "name": "constant.numeric.integer.zsh"		, "match": "\\d+" }
