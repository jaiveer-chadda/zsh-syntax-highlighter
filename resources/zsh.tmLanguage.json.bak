		},


		"compound-command": {
			"comment": "",
			"patterns": [
				{
					"name": "meta.scope.logical-expression.zsh",

					"begin"	: "\\[",
					"end"		: "\\]",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.logical-expression.zsh" } },
