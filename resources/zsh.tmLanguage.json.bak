				{ "include": "#array_value" },
				{
					"match": "(?:((?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))(?:(?:(\\[)((?:(?:(?:(?:\\$?)(?:(?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))|@)|\\*)|(-?\\d+)))(\\]))?)(?:(?:(?:(\\=)|(\\+\\=))|(\\-\\=))?)(?:(?:(?<==| |\\t|^|\\{|\\(|\\[)(?:(?:(?:(?:(?:(0[xX][0-9A-Fa-f]+)|(0\\d+))|(\\d{1,2}#[0-9a-zA-Z@_]+))|(-?\\d+(?:\\.\\d+)))|(-?\\d+(?:\\.\\d+)+))|(-?\\d+))(?= |\\t|$|\\}|\\)|;))?))",
					"captures": {
						"1"	: { "name": "variable.other.assignment.zsh" },
						"2"	: { "name": "punctuation.definition.array.access.zsh" },
						"3"	: { "name": "variable.other.assignment.zsh" },
						"4"	: { "name": "constant.numeric.zsh constant.numeric.integer.zsh" },
						"5"	: { "name": "punctuation.definition.array.access.zsh" },
						"6"	: { "name": "keyword.operator.assignment.zsh" },
						"7"	: { "name": "keyword.operator.assignment.compound.zsh" },
						"8"	: { "name": "keyword.operator.assignment.compound.zsh" },
						"9"	: { "name": "constant.numeric.zsh constant.numeric.hex.zsh" },
						"10": { "name": "constant.numeric.zsh constant.numeric.octal.zsh" },
						"11": { "name": "constant.numeric.zsh constant.numeric.other.zsh" },
						"12": { "name": "constant.numeric.zsh constant.numeric.decimal.zsh" },
						"13": { "name": "constant.numeric.zsh constant.numeric.version.zsh" },
						"14": { "name": "constant.numeric.zsh constant.numeric.integer.zsh" }
					}
				},
				{ "include": "#normal_context" }
			]
		},


		"modifiers": {
			"name": "storage.modifier.$0.zsh",
			"comment": "",
			"match": "(?<=^|;|&|[ \\t])(?:readonly|declare|typeset|export|local)(?=[ \\t]|;|&|$)"
		},


		"normal_assignment_statement": {
			"name": "meta.expression.assignment.zsh",
			"comment": "",

			"begin"	: "(?:[ \\t]*+)(?:((?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))(?:(?:(\\[)((?:(?:(?:(?:\\$?)(?:(?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w))|@)|\\*)|(-?\\d+)))(\\]))?))(?:(?:(\\=)|(\\+\\=))|(\\-\\=))",
			"end"		: "(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)",

			"beginCaptures": {
				"1": { "name": "variable.other.assignment.zsh" },
				"2": { "name": "punctuation.definition.array.access.zsh" },
				"3": { "name": "variable.other.assignment.zsh" },
				"4": {
					"name": "constant.numeric.zsh constant.numeric.integer.zsh"
				},
				"5": { "name": "punctuation.definition.array.access.zsh" },
				"6": { "name": "keyword.operator.assignment.zsh" },
				"7": { "name": "keyword.operator.assignment.compound.zsh" },
				"8": { "name": "keyword.operator.assignment.compound.zsh" }
			},
			"endCaptures": {},

			"patterns": [
				{ "include": "#comment" },
				{ "include": "#string" },
				{ "include": "#normal_assignment_statement" },
				{
					"name": "meta.statement.command.env.zsh",

					"begin"	: "(?<= |\\t)(?! |\\t|\\w+=)",
					"end"		: "(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)",

					"beginCaptures"	: {},
					"endCaptures"		: {},

					"patterns": [
						{ "include": "#command_name_range" },
						{ "include": "#line_continuation" },
						{ "include": "#option" },
						{ "include": "#argument" },
						{ "include": "#string" }
					]
				},
				{ "include": "#simple_unquoted" },
				{ "include": "#normal_context" }
			]
		},


		"normal_statement": {
			"name": "meta.statement.zsh",
			"comment": "",

			"begin"	: "(?:(?!^[ \\t]*+$)(?:(?<=^until | until |\\tuntil |^while | while |\\twhile |^elif | elif |\\telif |^else | else |\\telse |^then | then |\\tthen |^do | do |\\tdo |^if | if |\\tif )|(?<=(?:^|;|\\||&|!|\\(|\\{|\\`)))(?:[ \\t]*+)(?!nocorrect\\W|nocorrect\\$|function\\W|function\\$|foreach\\W|foreach\\$|repeat\\W|repeat\\$|logout\\W|logout\\$|coproc\\W|coproc\\$|select\\W|select\\$|while\\W|while\\$|pushd\\W|pushd\\$|until\\W|until\\$|case\\W|case\\$|done\\W|done\\$|elif\\W|elif\\$|else\\W|else\\$|esac\\W|esac\\$|popd\\W|popd\\$|then\\W|then\\$|time\\W|time\\$|for\\W|for\\$|end\\W|end\\$|fi\\W|fi\\$|do\\W|do\\$|in\\W|in\\$|if\\W|if\\$))",
			"end"		: "(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)",

			"beginCaptures"	: {},
			"endCaptures"		: {},

			"patterns": [{ "include": "#typical_statements" }]
		},


		"normal_statement_seperator": {
			"comment": "",
			"match": "(?:(?:(?:(;)|(&&))|(\\|\\|))|(&))",
			"captures": {
				"1": { "name": "punctuation.terminator.statement.semicolon.zsh" },
				"2": { "name": "punctuation.separator.statement.and.zsh" },
				"3": { "name": "punctuation.separator.statement.or.zsh" },
				"4": { "name": "punctuation.separator.statement.background.zsh" }
			}
		},


		"numeric_literal": {
			"comment": "",
			"match": "(?<==| |\\t|^|\\{|\\(|\\[)(?:(?:(?:(?:(?:(0[xX][0-9A-Fa-f]+)|(0\\d+))|(\\d{1,2}#[0-9a-zA-Z@_]+))|(-?\\d+(?:\\.\\d+)))|(-?\\d+(?:\\.\\d+)+))|(-?\\d+))(?= |\\t|$|\\}|\\)|;)",
			"captures": {
				"1": { "name": "constant.numeric.zsh constant.numeric.hex.zsh" },
				"2": { "name": "constant.numeric.zsh constant.numeric.octal.zsh" },
				"3": { "name": "constant.numeric.zsh constant.numeric.other.zsh" },
				"4": { "name": "constant.numeric.zsh constant.numeric.decimal.zsh" },
				"5": { "name": "constant.numeric.zsh constant.numeric.version.zsh" },
				"6": { "name": "constant.numeric.zsh constant.numeric.integer.zsh" }
			}
		},


		"option": {
			"comment": "",
			"contentName": "string.unquoted.argument constant.other.option",

			"begin"	: "(?:(?:[ \\t]++)(-)((?!(?:!|&|\\||\\(|\\)|\\{|\\[|<|>|#|\\n|$|;|[ \\t]))))",
			"end"		: "(?:(?=[ \\t])|(?:(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)))",

			"beginCaptures": {
				"1": { "name": "string.unquoted.argument.zsh constant.other.option.dash.zsh" },
				"2": { "name": "string.unquoted.argument.zsh constant.other.option.zsh" }
			},
			"endCaptures": {},

			"patterns": [{ "include": "#option_context" }]
		},


		"parenthese": {
			"comment": "",
			"patterns": [
				{
					"name": "meta.parenthese.group.zsh",

					"begin"	: "\\(",
					"end"		: "\\)",

					"beginCaptures"	: { "0": { "name": "punctuation.section.parenthese.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.section.parenthese.zsh" } },

					"patterns": [{ "include": "#initial_context" }]
				}
			]
		},


		"pathname": {
			"comment": "",
			"patterns": [
				{ "name": "keyword.operator.tilde.zsh", "match": "(?<=\\s|:|=|^)~" },
				{ "name": "keyword.operator.glob.zsh"	, "match": "\\*|\\?" },
				{
					"name": "meta.structure.extglob.zsh",

					"begin"	: "([?*+@!])(\\()",
					"end"		: "\\)",

					"beginCaptures": {
						"1": { "name": "keyword.operator.extglob.zsh" },
						"2": { "name": "punctuation.definition.extglob.zsh" }
					},
					"endCaptures": { "0": { "name": "punctuation.definition.extglob.zsh" } },

					"patterns": [{ "include": "#initial_context" }]
				}
			]
		},


		"pipeline": {
			"comment": "",
			"patterns": [
				{ "name": "keyword.other.zsh"					, "match": "(?<=^|;|&|\\s)(time)(?=\\s|;|&|$)" },
				{ "name": "keyword.operator.pipe.zsh"	, "match": "[|!]" }
			]
		},


		"redirect_fix": {
			"comment": "",
			"match": "(?:(>>?)(?:[ \\t]*+)([^ \t\n>&;<>\\(\\)\\$`\\\\\"'<\\|]+))",
			"captures": {
				"1": { "name": "keyword.operator.redirect.zsh" },
				"2": { "name": "string.unquoted.argument.zsh" }
			}
		},


		"redirect_number": {
			"comment": "",
			"match": "(?<=[ \\t])(?:(?:(1)|(2)|(\\d+))(?=>))",
			"captures": {
				"1": { "name": "keyword.operator.redirect.stdout.zsh" },
				"2": { "name": "keyword.operator.redirect.stderr.zsh" },
				"3": { "name": "keyword.operator.redirect.$3.zsh" }
			}
		},


		"redirection": {
			"comment": "",
			"patterns": [
				{
					"name": "string.interpolated.process-substitution.zsh",

					"begin": "[><]\\(",
					"end": "\\)",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.string.begin.zsh"	} },
					"endCaptures"		: { "0": { "name": "punctuation.definition.string.end.zsh"		} },

					"patterns": [{ "include": "#initial_context" }]
				},
				{
					"name": "keyword.operator.redirect.zsh",
					"match": "(?<![<>])(&>|\\d*>&\\d*|\\d*(>>|>|<)|\\d*<&|\\d*<>)(?![<>])"
				}
			]
		},


		"regex_comparison": {
			"name": "keyword.operator.logical.regex.zsh",
			"comment": "",
			"match": "\\=~"
		},


		"regexp": { "patterns": [{ "match": "(?:.+)" }] },

		"simple_options": {
			"comment": "",
			"match": "(?:(?:[ \\t]++)\\-(?:\\w+))*",

			"captures": {
				"0": {
					"patterns": [{
						"match": "(?:[ \\t]++)(\\-)(\\w+)",
						"captures": {
							"1": { "name": "string.unquoted.argument.zsh constant.other.option.dash.zsh" },
							"2": { "name": "string.unquoted.argument.zsh constant.other.option.zsh" }
						}
					}]
				}
			}
		},


		"simple_unquoted": {
			"name": "string.unquoted.zsh",
			"comment": "",
			"match": "[^ \\t\\n>&;<>\\(\\)\\$`\\\\\"'<\\|]"
		},


		"special_expansion": {
			"name": "keyword.operator.expansion.zsh",
			"comment": "",
			"match": "!|:[-=?]?|\\*|@|##|#|%%|%|\\/"
		},


		"start_of_command": {
			"comment": "",
			"match": "(?:(?:[ \\t]*+)(?:(?!(?:!|&|\\||\\(|\\)|\\{|\\[|<|>|#|\\n|$|;|[ \\t]))(?!nocorrect |nocorrect\t|nocorrect$|readonly |readonly\t|readonly$|function |function\t|function$|foreach |foreach\t|foreach$|coproc |coproc\t|coproc$|logout |logout\t|logout$|export |export\t|export$|select |select\t|select$|repeat |repeat\t|repeat$|pushd |pushd\t|pushd$|until |until\t|until$|while |while\t|while$|local |local\t|local$|case |case\t|case$|done |done\t|done$|elif |elif\t|elif$|else |else\t|else$|esac |esac\t|esac$|popd |popd\t|popd$|then |then\t|then$|time |time\t|time$|for |for\t|for$|end |end\t|end$|fi |fi\t|fi$|do |do\t|do$|in |in\t|in$|if |if\t|if$)(?!\\\\\\n?$)))"
		},


		"string": {
			"comment": "",
			"patterns": [
				{ "match": "\\\\.", "name": "constant.character.escape.zsh" },

				{
					"name": "string.quoted.single.zsh",

					"begin"	: "'",
					"end"		: "'",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.string.begin.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.definition.string.end.zsh" } }
				},


				{
					"name": "string.quoted.double.zsh",

					"begin"	: "\\$?\"",
					"end"		: "\"",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.string.begin.zsh"	} },
					"endCaptures"		: { "0": { "name": "punctuation.definition.string.end.zsh"		} },

					"patterns": [
						{ "name": "constant.character.escape.zsh", "match": "\\\\[\\$\\n`\"\\\\]" },
						{ "include": "#variable" },
						{ "include": "#interpolation" }
					]
				},


				{
					"name": "string.quoted.single.dollar.zsh",

					"begin"	: "\\$'",
					"end"		: "'",

					"beginCaptures"	: { "0": { "name": "punctuation.definition.string.begin.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.definition.string.end.zsh" } },

					"patterns": [
						{ "name": "constant.character.escape.ansi-c.zsh"			, "match": "\\\\(?:a|b|e|f|n|r|t|v|\\\\|')"	},
						{ "name": "constant.character.escape.octal.zsh"				, "match": "\\\\[0-9]{3}\""									},
						{ "name": "constant.character.escape.hex.zsh"					, "match": "\\\\x[0-9a-fA-F]{2}\""					},
						{ "name": "constant.character.escape.control-char.zsh", "match": "\\\\c.\""												}
					]
				}
			]
		},


		"subshell_dollar": {
			"comment": "",
			"patterns": [{
				"name": "meta.scope.subshell",

				"begin"	: "(?:\\$\\()",
				"end"		: "\\)",

				"beginCaptures"	: { "0": { "name": "punctuation.definition.subshell.single.zsh" } },
				"endCaptures"		: { "0": { "name": "punctuation.definition.subshell.single.zsh" } },

				"patterns": [
					{ "include": "#parenthese" },
					{ "include": "#initial_context" }
				]
			}]
		},


		"support": {
			"comment": "",
			"patterns": [{
				"name": "support.function.builtin.zsh",
				"match": "(?<=^|;|&|\\s)(?::|\\.)(?=\\s|;|&|$)"
			}]
		},


		"variable": {
			"comment": "",
			"patterns": [
				{
					"match": "(?:(\\$)(\\@(?!\\w)))",
					"captures": {
						"1": { "name": "punctuation.definition.variable.zsh variable.parameter.positional.all.zsh" },
						"2": { "name": "variable.parameter.positional.all.zsh" }
					}
				},


				{
					"match": "(?:(\\$)([0-9](?!\\w)))",
					"captures": {
						"1": { "name": "punctuation.definition.variable.zsh variable.parameter.positional.zsh" },
						"2": { "name": "variable.parameter.positional.zsh" }
					}
				},


				{
					"match": "(?:(\\$)([-*#?$!0_](?!\\w)))",
					"captures": {
						"1": { "name": "punctuation.definition.variable.zsh variable.language.special.zsh" },
						"2": { "name": "variable.language.special.zsh" }
					}
				},


				{
					"contentName": "meta.parameter-expansion",

					"begin"	: "(?:(\\$)(\\{)(?:[ \\t]*+)(?=\\d))",
					"end"		: "\\}",

					"beginCaptures": {
						"1": { "name": "punctuation.definition.variable.zsh variable.parameter.positional.zsh" },
						"2": { "name": "punctuation.section.bracket.curly.variable.begin.zsh punctuation.definition.variable.zsh variable.parameter.positional.zsh" }
					},
					"endCaptures": { "0": { "name": "punctuation.section.bracket.curly.variable.end.zsh punctuation.definition.variable.zsh variable.parameter.positional.zsh" } },

					"patterns": [
						{ "include": "#special_expansion" },
						{ "include": "#array_access_inline" },
						{ "name": "variable.parameter.positional.zsh"	, "match": "[0-9]+"															},
						{ "name": "variable.other.normal.zsh"					, "match": "(?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w)"	},
						{ "include": "#variable" },
						{ "include": "#string" }
					]
				},


				{
					"contentName": "meta.parameter-expansion",

					"begin"	: "(?:(\\$)(\\{))",
					"end"		: "\\}",

					"beginCaptures": {
						"1": { "name": "punctuation.definition.variable.zsh" },
						"2": { "name": "punctuation.section.bracket.curly.variable.begin.zsh punctuation.definition.variable.zsh" }
					},
					"endCaptures": { "0": { "name": "punctuation.section.bracket.curly.variable.end.zsh punctuation.definition.variable.zsh" } },

					"patterns": [
						{ "include": "#special_expansion" },
						{ "include": "#array_access_inline" },
						{ "name": "variable.other.normal.zsh", "match": "(?<!\\w)(?:[a-zA-Z_0-9-]+)(?!\\w)" },
						{ "include": "#variable" },
						{ "include": "#string" }
					]
				},


				{
					"match": "(?:(\\$)((?:\\w+)(?!\\w)))",
					"captures": {
						"1": { "name": "punctuation.definition.variable.zsh variable.other.normal.zsh" },
						"2": { "name": "variable.other.normal.zsh" }
					}
				}

			]
		},


		"while_statement": {
			"comment": "",
			"patterns": [
				{
					"name": "meta.while.zsh",

					"begin"	: "(\\bwhile\\b)",
					"end"		: "(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)",

					"beginCaptures"	: { "1": { "name": "keyword.control.while.zsh" } },
					"endCaptures"		: {},

					"patterns": [
						{ "include": "#line_continuation" },
						{ "include": "#math_operators" },
						{ "include": "#option" },
						{ "include": "#simple_unquoted" },
						{ "include": "#normal_context" },
						{ "include": "#string" }
					]
				}
			]
		},




		"custom_command_names": { "patterns": [] },
		"custom_commands"	:		 	{ "patterns": [] }
	}

}
