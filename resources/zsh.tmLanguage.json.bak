					"end"		: "}",

					"beginCaptures"	: { "1": { "name": "punctuation.definition.group.zsh" } },
					"endCaptures"		: { "0": { "name": "punctuation.definition.group.zsh" } },

					"patterns": [{ "include": "#initial_context" }]
				}
			]
		},


		"modified_assignment_statement": {
			"name": "meta.statement.zsh meta.expression.assignment.modified.zsh",
			"comment": "",

			"begin"	: "(?<=^|;|&|[ \\t])(?:readonly|declare|typeset|export|local)(?=[ \\t]|;|&|$)",
			"end"		: "(?=;|\\||&|\\n|\\)|\\`|\\{|\\}|[ \\t]*#|\\])(?<!\\\\)",

